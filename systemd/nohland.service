# Servicio de usuario. Va atado a graphical-session.target, que UWSM levanta
# con el entorno de Hyprland ya importado (HYPRLAND_INSTANCE_SIGNATURE,
# WAYLAND_DISPLAY); si la sesion cae, el servicio cae con ella.
[Unit]
Description=NoHland: gestor de fondos de pantalla
Documentation=file://%h/Proyectos/NoHland/README.md
PartOf=graphical-session.target
After=graphical-session.target
Requisite=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/bin/nohland daemon
Restart=on-failure
RestartSec=2

[Install]
WantedBy=graphical-session.target
